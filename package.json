{
  "name": "@chronary/mcp",
  "mcpName": "ai.chronary/mcp",
  "version": "1.5.0",
  "description": "MCP server for Chronary — calendar tools for AI assistants (Claude Desktop, Cursor, VS Code, Windsurf)",
  "author": "Chronary (https://chronary.ai)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "chronary-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chronary",
    "calendar",
    "ai",
    "ai-agent",
    "claude",
    "cursor",
    "vscode"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Chronary/chronary-mcp"
  },
  "homepage": "https://chronary.ai",
  "bugs": {
    "url": "https://github.com/Chronary/chronary-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smithery:republish": "npx -y @smithery/cli@latest mcp publish https://api.chronary.ai/mcp -n chronary/agent-calendar --config-schema smithery-remote-config.json"
  },
  "dependencies": {
    "@chronary/sdk": "workspace:*",
    "@chronary/toolkit": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
