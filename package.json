{
  "name": "chronary-mcp",
  "version": "0.1.2",
  "description": "MCP server for Chronary — calendar tools for AI assistants (Claude Desktop, Cursor, VS Code, Windsurf)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "chronary-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chronary",
    "calendar",
    "ai",
    "ai-agent",
    "claude",
    "cursor",
    "vscode"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Chronary/chronary-mcp"
  },
  "homepage": "https://docs.chronary.ai",
  "bugs": {
    "url": "https://github.com/Chronary/chronary-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chronary/sdk": "workspace:*",
    "@chronary/toolkit": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
